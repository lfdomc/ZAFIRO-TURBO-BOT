# Copia este archivo a .env para pruebas locales.
# En Railway, estas mismas variables van en el servicio -> pestaña Variables.

SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=tu_clave_service_role_secret
# IMPORTANTE: usa la clave "service_role" (Settings -> API -> Project API
# keys), NUNCA la "anon" — este backend es un servidor de confianza, no
# código de navegador. service_role ignora RLS por diseño.

TELEGRAM_BOT_TOKEN=1234567890:AA...
TELEGRAM_WEBHOOK_SECRET=un-secreto-que-tu-inventes

# Fase 1: solo estos chat_id de Telegram (separados por coma) pueden
# usar el bot — el equipo admin. Tu chat_id lo obtenés escribiéndole a
# @userinfobot en Telegram. Dejar vacío desactiva el whitelist (NO
# recomendado en producción, ya que expondría datos internos a
# cualquiera).
ADMIN_CHAT_IDS=123456789,987654321

# Pool de claves de Gemini — agregá tantas como quieras, cualquier
# nombre que empiece con GEMINI_KEY_ se detecta automáticamente.
GEMINI_KEY_1=AQ....
GEMINI_KEY_2=AQ....

# Clave compartida que protege el panel Admin del sitio y el export
# estático — inventá un valor largo y random. La misma clave va:
#  - acá (backend)
#  - en Vercel como BOT_ADMIN_KEY (usada por generar-propiedades.mjs en el build)
#  - la escribís vos en la pestaña Admin del sitio la primera vez que la abrís
ADMIN_API_KEY=un-valor-largo-y-random-que-vos-inventes

# Vercel -> tu proyecto -> Settings -> Git -> Deploy Hooks -> crear uno
# y pegar la URL acá. Si se deja vacío, guardar una propiedad desde el
# panel Admin sigue funcionando, pero el sitio no se redespliega solo
# (tendrías que hacerlo a mano).
VERCEL_DEPLOY_HOOK_URL=

# WhatsApp Cloud API (Meta) — reportes de mantenimiento/limpieza.
# Ver README, sección "Reportes de mantenimiento/limpieza por WhatsApp".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=reporte_incidencia
WHATSAPP_TEMPLATE_LANG=es

# Números de los coordinadores — se usan para TODAS las propiedades.
# Formato internacional, con + y sin espacios.
WHATSAPP_MANTENIMIENTO_DEFAULT=+506xxxxxxxx
WHATSAPP_LIMPIEZA_DEFAULT=+506xxxxxxxx

# URL pública de tu sitio en Vercel (sin / al final) — se usa para armar
# el link de consulta temporal para huéspedes.
SITE_BASE_URL=https://tu-sitio.vercel.app
ACCESO_TEMPORAL_HORAS=24

# Minutos que espera el bot antes de mandar el reporte solo por
# WhatsApp si nadie tocó los botones en Telegram.
AUTO_ENVIO_WHATSAPP_MINUTOS=10
